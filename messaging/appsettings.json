{
	"Logging": {
		"LogLevel": {
			"Default": "Debug",
			"Microsoft.AspNetCore": "Debug",
			"Microsoft.AspNetCore.Authentication": "Debug"
		}
	},
	"AllowedHosts": "*",
	"Jwt": {
		"Secret": "aVeryLongSecretKeyThatIsAtLeast32BytesLong",
		"Audience": "api",
		"Issuer": "http://localhost:5000"
	},
	"Kestrel": {
		"Endpoints": {
			"HttpsInlineCertFile": {
				"Url": "https://localhost:5500",
				"Protocols": "Http1AndHttp2",
				"Certificate": {
					"Path": "../cert.pfx",
					"Password": "testpassword"
				}
			}
		}
	}
}
